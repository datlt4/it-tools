# Image (mặc định pull từ Docker Hub, không cần build)
FRONTEND_IMAGE=hienanh/it-tools-frontend:latest
CONVERTER_IMAGE=hienanh/it-tools-converter:latest

# Port host trên mini PC (8080/8000 đã bận -> dùng 8018/8021)
FRONTEND_PORT=8018
CONVERTER_PORT=8021

# Bake vào frontend lúc docker build (Vite static).
# Để trống = frontend tự gọi cùng hostname + port 8000 lúc runtime.
# VD deploy mini PC qua WireGuard:
VITE_CONVERTER_API_URL=http://24.8.0.2:8021
